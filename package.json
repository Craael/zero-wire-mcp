{
  "name": "zero-wire-mcp",
  "version": "0.1.1",
  "description": "Unofficial, independent MCP server for Cloudflare® Zero Wire vulnerability briefings. Not affiliated with Cloudflare, Inc.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zero-wire-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vulnerability",
    "cve",
    "security"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --import tsx --test \"test/*.test.ts\"",
    "test:live": "npm run build && node --import tsx --test \"test/live/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craael/zero-wire-mcp.git"
  },
  "homepage": "https://github.com/Craael/zero-wire-mcp#readme",
  "bugs": {
    "url": "https://github.com/Craael/zero-wire-mcp/issues"
  }
}
